    "You confirmed that anonymized diagnostics may be attached." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपने पुष्टि की है कि अनाम नैदानिक जानकारी संलग्न की जा सकती है।" } }
