{
  "sourceLanguage" : "en",
  "strings" : {
    "A general-wellness plan is suitable for me" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सामान्य स्वास्थ्य योजना मेरे लिए उपयुक्त है" } }
      }
    },
    "Back" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "वापस" } }
      }
    },
    "Build my week" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मेरा सप्ताह बनाएँ" } }
      }
    },
    "Continue" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आगे बढ़ें" } }
      }
    },
    "Create or review a weekly plan" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "साप्ताहिक योजना बनाएँ या देखें" } }
      }
    },
    "Delete account" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खाता हटाएँ" } }
      }
    },
    "First, a quick safety check." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले, एक छोटी सुरक्षा जाँच।" } }
      }
    },
    "Groceries" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "किराने की सूची" } }
      }
    },
    "I am 18 years or older" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मेरी आयु 18 वर्ष या अधिक है" } }
      }
    },
    "Let’s begin" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "शुरू करें" } }
      }
    },
    "My week" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मेरा सप्ताह" } }
      }
    },
    "Nourish supports general wellness and meal organization—not clinical diets." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "Nourish सामान्य स्वास्थ्य और भोजन व्यवस्था में मदद करता है—चिकित्सकीय आहार में नहीं।" } }
      }
    },
    "Off by default. When enabled, Nourish records only named product events with bounded properties. It does not include email, profile answers, meal history, free text, advertising identifiers, or device fingerprints." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह डिफ़ॉल्ट रूप से बंद है। चालू करने पर Nourish केवल सीमित उत्पाद-उपयोग घटनाएँ दर्ज करता है; ईमेल, प्रोफ़ाइल उत्तर, भोजन इतिहास, मुक्त पाठ, विज्ञापन पहचानकर्ता या डिवाइस फ़िंगरप्रिंट नहीं।" } }
      }
    },
    "Onboarding progress" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "शुरुआती सेटअप की प्रगति" } }
      }
    },
    "Open profile and settings" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्रोफ़ाइल और सेटिंग्स खोलें" } }
      }
    },
    "Permanently delete account" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खाता स्थायी रूप से हटाएँ" } }
      }
    },
    "Prep" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "तैयारी" } }
      }
    },
    "Profile & settings" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्रोफ़ाइल और सेटिंग्स" } }
      }
    },
    "Seven days. Far fewer decisions." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सात दिन। बहुत कम फैसले।" } }
      }
    },
    "Share first-party product usage" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "उत्पाद उपयोग साझा करें" } }
      }
    },
    "Today" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आज" } }
      }
    },
    "Type DELETE to continue." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आगे बढ़ने के लिए DELETE लिखें।" } }
      }
    },
    "We’ll turn your preferences, budget, and cooking rhythm into practical meals, groceries, and prep." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "हम आपकी पसंद, बजट और खाना पकाने की दिनचर्या को व्यावहारिक भोजन, किराने की सूची और तैयारी में बदलेंगे।" } }
      }
    },
    "Add the approved App Store product identifiers before testing purchases." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खरीदारी जाँचने से पहले स्वीकृत App Store उत्पाद पहचानकर्ता जोड़ें।" } }
      }
    },
    "Adopt this reviewed week" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस समीक्षित सप्ताह को अपनाएँ" } }
      }
    },
    "Cancel any time in App Store subscription settings" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "App Store सदस्यता सेटिंग में कभी भी रद्द करें" } }
      }
    },
    "Changes are protected on this device and synchronized to your account." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "बदलाव इस डिवाइस पर सुरक्षित हैं और आपके खाते से सिंक किए गए हैं।" } }
      }
    },
    "Checking safe swaps…" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सुरक्षित विकल्प जाँचे जा रहे हैं…" } }
      }
    },
    "Choose the plan that fits your routine. Apple shows the final local price, billing period, trial terms, and renewal details before purchase." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपनी दिनचर्या के अनुरूप योजना चुनें। खरीदने से पहले Apple अंतिम स्थानीय कीमत, बिलिंग अवधि, परीक्षण शर्तें और नवीनीकरण विवरण दिखाता है।" } }
      }
    },
    "Close" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद करें" } }
      }
    },
    "Decrease quantity by 50 grams" : {
