      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "समीक्षित सप्ताह सक्रिय हो गया" } }
      }
    },
    "Saved offline" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "ऑफ़लाइन सहेजा गया" } }
      }
    },
    "Show safe swaps" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सुरक्षित विकल्प दिखाएँ" } }
      }
    },
    "Shows only replacements that keep the whole week within your safety and variety rules" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "केवल वे विकल्प दिखाता है जो पूरे सप्ताह को आपकी सुरक्षा और विविधता के नियमों में रखते हैं" } }
      }
    },
    "Subscriptions not configured" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सदस्यताएँ कॉन्फ़िगर नहीं हैं" } }
      }
    },
    "Today, Week, Groceries, and Prep now use this immutable reviewed plan." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आज, सप्ताह, किराने और तैयारी अब इस अपरिवर्तनीय समीक्षित योजना का उपयोग करते हैं।" } }
