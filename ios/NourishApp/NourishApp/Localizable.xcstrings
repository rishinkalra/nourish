      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "जब तक सूत्र और सुरक्षा सीमाओं की योग्य पोषण समीक्षा नहीं हो जाती, अनुमानक उपलब्ध नहीं रहेगा।" } }
