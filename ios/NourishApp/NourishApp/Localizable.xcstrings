    },
    "There are not enough licensed, reviewed recipes for this profile yet. Your current week is unchanged." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस प्रोफ़ाइल के लिए अभी पर्याप्त लाइसेंस प्राप्त, समीक्षित रेसिपी नहीं हैं। आपका वर्तमान सप्ताह नहीं बदला है।" } } }
    },
    "Nourish could not build a safe varied week. Try fewer locks or review cooking constraints." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "Nourish सुरक्षित और विविध सप्ताह नहीं बना सका। कम भोजन लॉक करें या खाना पकाने की सीमाएँ जाँचें।" } } }
    },
    "Complete the required planning preferences before generating a week." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "सप्ताह बनाने से पहले आवश्यक योजना प्राथमिकताएँ पूरी करें।" } } }
    },
    "Subscription status could not be refreshed. Existing server access is unchanged." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "सदस्यता स्थिति रीफ़्रेश नहीं हो सकी। मौजूदा सर्वर पहुँच नहीं बदली है।" } } }
    },
    "The export request was not confirmed. You can safely retry." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "निर्यात अनुरोध की पुष्टि नहीं हुई। आप सुरक्षित रूप से फिर प्रयास कर सकते हैं।" } } }
    },
    "Deletion was not confirmed. Your account remains available; please retry." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटाने की पुष्टि नहीं हुई। आपका खाता उपलब्ध है; कृपया फिर प्रयास करें।" } } }
    },
    "App Store plans could not be loaded. No purchase was started." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "App Store योजनाएँ लोड नहीं हो सकीं। कोई खरीद शुरू नहीं हुई।" } } }
    },
    "Apple could not verify this transaction. No Nourish access was changed." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "Apple इस लेनदेन की पुष्टि नहीं कर सका। Nourish पहुँच नहीं बदली।" } } }
    },
    "Purchase verified. Your Nourish access is now linked to this account." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "खरीद सत्यापित हुई। आपकी Nourish पहुँच अब इस खाते से जुड़ी है।" } } }
    },
    "The purchase is awaiting approval. Access will update after Apple confirms it." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "खरीद स्वीकृति की प्रतीक्षा में है। Apple की पुष्टि के बाद पहुँच अपडेट होगी।" } } }
    },
    "Purchase cancelled." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "खरीद रद्द हुई।" } } }
    },
    "The App Store returned an unknown purchase result. No access was changed." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "App Store ने अज्ञात खरीद परिणाम दिया। पहुँच नहीं बदली।" } } }
    },
    "The purchase could not be verified by the Nourish server. Existing access is unchanged." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "Nourish सर्वर खरीद सत्यापित नहीं कर सका। मौजूदा पहुँच नहीं बदली है।" } } }
    },
    "The App Store purchase could not be verified for this Nourish account right now. Existing server access is unchanged." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Nourish खाते के लिए App Store खरीद अभी सत्यापित नहीं हो सकी। मौजूदा सर्वर पहुँच नहीं बदली है।" } } }
    },
    "Purchase history was verified by Apple and linked to this Nourish account." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "खरीद इतिहास Apple द्वारा सत्यापित होकर इस Nourish खाते से जुड़ गया।" } } }
    },
    "Purchase history synchronized. No current subscription entitlement was found." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "खरीद इतिहास सिंक हो गया। कोई वर्तमान सदस्यता अधिकार नहीं मिला।" } } }
    },
    "An offline swap needs review before it can be confirmed." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "ऑफ़लाइन बदलाव की पुष्टि से पहले समीक्षा आवश्यक है।" } } }
    },
    "Please sign in again." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "कृपया फिर से साइन इन करें।" } } }
    },
    "This sign-in link is invalid or incomplete." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह साइन-इन लिंक अमान्य या अधूरा है।" } } }
    },
    "Your preferences changed elsewhere. Refresh and try again." : {
      "localizations" : { "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी प्राथमिकताएँ कहीं और बदली हैं। रीफ़्रेश करके फिर प्रयास करें।" } } }
