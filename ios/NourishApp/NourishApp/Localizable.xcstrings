    "Plan dinner" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "रात के भोजन की योजना बनाएँ" } }
      }
    },
    "Plan lunch" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "दोपहर के भोजन की योजना बनाएँ" } }
      }
    },
    "Processor list, retention periods, cross-border basis, grievance contact, and counsel-approved launch policy remain pending business decisions." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्रोसेसर सूची, डेटा रखने की अवधि, सीमा-पार आधार, शिकायत संपर्क और कानूनी रूप से स्वीकृत लॉन्च नीति अभी व्यावसायिक निर्णय हैं।" } }
      }
    },
    "Reminder times use " : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर का समय इस समय क्षेत्र का उपयोग करता है: " } }
      }
    },
