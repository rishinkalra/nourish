    "Account" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खाता" } }
      }
    },
    "Building a safe, varied week…" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "सुरक्षित और विविध सप्ताह बनाया जा रहा है…" } }
      }
    },
    "Complete onboarding before creating a reviewed week." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "समीक्षित सप्ताह बनाने से पहले शुरुआती सेटअप पूरा करें।" } }
      }
    },
    "Cooking days" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "खाना पकाने के दिन" } }
      }
    },
    "Create your first reviewed week" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपना पहला समीक्षित सप्ताह बनाएँ" } }
      }
    },
    "Daily target" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "दैनिक लक्ष्य" } }
      }
    },
    "Diet" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आहार" } }
      }
    },
    "Done" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "पूर्ण" } }
      }
    },
    "Draft" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "मसौदा" } }
      }
    },
    "Edit planning preferences" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "योजना प्राथमिकताएँ संपादित करें" } }
      }
    },
    "Generate reviewed week" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "समीक्षित सप्ताह बनाएँ" } }
      }
    },
    "Generation never overrides allergens or hard exclusions. Adopting is a separate confirmation." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "योजना बनाते समय एलर्जी या अनिवार्य निषेध कभी नहीं बदले जाते। योजना अपनाने की पुष्टि अलग से होती है।" } }
      }
    },
    "Hard diet, allergen, exclusion, review, cooking-time, and variety rules run before preferences." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "पसंद से पहले आहार, एलर्जी, निषेध, समीक्षा, खाना पकाने के समय और विविधता के अनिवार्य नियम लागू होते हैं।" } }
      }
    },
    "Include an optional snack" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "वैकल्पिक नाश्ता शामिल करें" } }
      }
    },
    "Leftovers" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "बचा हुआ भोजन" } }
      }
    },
    "Legal & support" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "कानूनी और सहायता" } }
      }
    },
    "Locked meals are rechecked against your current safety rules. Planned leftovers must stay linked to their batch source." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "लॉक किए गए भोजन आपके मौजूदा सुरक्षा नियमों के अनुसार फिर जाँचे जाते हैं। नियोजित बचे भोजन का स्रोत जुड़ा रहना चाहिए।" } }
      }
    },
