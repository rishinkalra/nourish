      }
    },
    "Use this meal" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह भोजन चुनें" } }
      }
    },
    "Weekly shop" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "साप्ताहिक खरीदारी" } }
      }
    },
    "Your current week stays active. Nourish will switch on the new plan’s local start date." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका वर्तमान सप्ताह सक्रिय रहेगा। Nourish नई योजना की स्थानीय शुरुआत की तारीख पर इसे बदल देगा।" } }
      }
    },
    "Your meal history never changes your price" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका भोजन इतिहास आपकी कीमत नहीं बदलता" } }
      }
    },
    "Your reviewed day" : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका समीक्षित दिन" } }
