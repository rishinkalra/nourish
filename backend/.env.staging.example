# Copy to .env.staging and replace every CHANGE_ME value through your secret manager.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/CHANGE_ME_DATABASE
DATABASE_REQUIRE_TLS=true
DATABASE_POOL_MAX=10
DATABASE_AUTO_MIGRATE=false

# Private S3-compatible storage. Prefer workload identity; otherwise inject standard AWS SDK
# credential variables through the secret manager, never this file. Application-level AES-256-GCM
# encryption is mandatory in production and remains effective independently of the provider.
NOURISH_PRIVATE_OBJECT_STORE=s3
NOURISH_PRIVATE_OBJECT_BUCKET=CHANGE_ME_PRIVATE_BUCKET
NOURISH_PRIVATE_OBJECT_REGION=ap-south-1
NOURISH_PRIVATE_OBJECT_PREFIX=nourish/staging
NOURISH_PRIVATE_OBJECT_SSE=AES256
# One-line JSON key ring. Generate each value with `openssl rand -base64 32` and inject it as a secret.
# To rotate, add the new key, change the active ID, and retain old keys until their objects are gone.
NOURISH_PRIVATE_OBJECT_ENCRYPTION_ACTIVE_KEY_ID=staging-2026-07
NOURISH_PRIVATE_OBJECT_ENCRYPTION_KEYS={"staging-2026-07":"CHANGE_ME_BASE64_32_BYTE_KEY"}
# Optional for a non-AWS S3-compatible service; production endpoints must use HTTPS.
# NOURISH_PRIVATE_OBJECT_ENDPOINT=https://CHANGE_ME_OBJECT_ENDPOINT
# Set true only when the selected S3-compatible service requires path-style addressing.
NOURISH_PRIVATE_OBJECT_FORCE_PATH_STYLE=false
# For customer-managed KMS encryption, set SSE to aws:kms and inject the key ID.
# NOURISH_PRIVATE_OBJECT_KMS_KEY_ID=CHANGE_ME_KMS_KEY_ID
# DigitalOcean Spaces: use region us-east-1, endpoint https://syd1.digitaloceanspaces.com,
# force-path-style false, and SSE none. Application encryption remains mandatory.
NOURISH_ANALYTICS_RETENTION_DAYS=90
# AI recipe generation runs only in the worker and stores output in the reviewer quarantine.
NOURISH_RECIPE_GENERATION_ENABLED=true
NOURISH_OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
NOURISH_OPENAI_RECIPE_MODEL=gpt-5.6-sol
NOURISH_OPENAI_IMAGE_MODEL=gpt-image-2
NOURISH_OPENAI_TIMEOUT_MILLISECONDS=120000
# Independent HMAC secret for privacy-safe shared abuse counters. Generate with `openssl rand -hex 32`.
NOURISH_RATE_LIMIT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARACTERS
# Enable only behind a trusted ingress that replaces X-Forwarded-For.
NOURISH_TRUST_PROXY=true

# FamilyChef domain boundary:
# public site https://www.familychef.in
# staging API https://api-staging.familychef.in
# staging Control Room https://control-staging.familychef.in
# Transactional sign-in email. Verify familychef.in with the provider first.
NOURISH_EMAIL_PROVIDER=brevo
NOURISH_EMAIL_FROM=FamilyChef <sign-in@familychef.in>
NOURISH_BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
NOURISH_MAGIC_LINK_URL_PREFIX=nourish://auth/magic-link?token=
# Postmark remains supported as an alternative:
# NOURISH_EMAIL_PROVIDER=postmark
# NOURISH_POSTMARK_SERVER_TOKEN=CHANGE_ME_POSTMARK_SERVER_TOKEN

# These must exactly match reviewed, published catalogue snapshots.
NOURISH_PLANNER_ELIGIBLE_LOCALES=en-IN
NOURISH_PLANNER_NUTRITION_CALCULATION_VERSIONS=CHANGE_ME_REVIEWED_VERSION

NOURISH_ADMIN_ORIGIN=https://control-staging.familychef.in
NOURISH_APP_STORE_INGRESS_ENABLED=false
NOURISH_APP_STORE_RECONCILIATION_ENABLED=false
